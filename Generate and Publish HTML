name: Generate and Publish HTML

on:
  push:
    branches:
      - main  # Spustí se automaticky ihned po uložení (pokud se vaše větev jmenuje master, přepište to)
  schedule:
    - cron: '0 * * * *' # Nadále se bude spouštět i každou hodinu
  workflow_dispatch:    # Povoluje tlačítko pro ruční spuštění

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
      
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Generate HTML
        run: |
          mkdir -p public
          echo "<!DOCTYPE html>
          <html lang='cs'>
          <head>
            <meta charset='utf-8'>
            <title>Testovací stránka</title>
          </head>
          <body>
            <h1>Funguje to!</h1>
            <p>Tato stránka byla automaticky vygenerována v: <strong>$(date)</strong></p>
          </body>
          </html>" > public/index.html

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: './public'

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
